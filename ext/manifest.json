{
  "manifest_version": 3,
  "name": "Douyin Cinema UI",
  "version": "0.3.0",
  "description": "抖音网页版增强：播放区详情/无水印下载、进度条跳转兜底、章节提示、侧栏收放",
  "minimum_chrome_version": "116",
  "permissions": [
    "downloads",
    "storage",
    "sidePanel",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "*://*.douyin.com/*",
    "*://*.douyinvod.com/*",
    "*://*.byteimg.com/*",
    "*://*.douyinpic.com/*",
    "*://*.bytecdn.cn/*",
    "*://*.ibytedtos.com/*",
    "*://*.douyincdn.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "download",
        "enabled": false,
        "path": "rules/download.json"
      }
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.douyin.com/*"
      ],
      "js": [
        "content/boot.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.douyin.com/*"
      ],
      "js": [
        "content/page-hook.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.douyin.com/*"
      ],
      "js": [
        "content/content.js"
      ],
      "css": [
        "content/style.css"
      ],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "抖音增强 · 设置",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  }
}
